# Spotify connection (optional: importing the JSON export works without any of this). Setup: docs/SPOTIFY_SETUP.md
# Copy this file to .env.local for local development. On Vercel, add the same three under Project > Settings > Environment Variables.

# Client ID of your app at https://developer.spotify.com/dashboard . It is not a secret. There is no client secret: the app uses PKCE.
SPOTIFY_CLIENT_ID=

# Exactly the Redirect URI registered in the dashboard (case, slashes and all).
# Production must be https, e.g. https://your-app.vercel.app/api/spotify/callback
# Local development must be http://127.0.0.1:3000/api/spotify/callback ("localhost" is not accepted by Spotify).
SPOTIFY_REDIRECT_URI=

# 32 or more random characters. They encrypt the session cookie, so keep them private and never commit them.
# Any long random string works (a password manager can generate one), or:  openssl rand -base64 32
SESSION_SECRET=
